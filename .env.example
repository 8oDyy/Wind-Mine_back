GITHUB_TOKEN=your_github_pat_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_BUCKET_NAME=your_bucket_name
SUPABASE_WINE_LABELS_BUCKET=wine-labels
VISION_MODEL=gpt-4o
# Legacy JWT Secret (Dashboard → Settings → API). Le projet signe désormais les tokens en ES256
# (vérifiés via le JWKS public, dérivé de SUPABASE_URL) ; ce secret HS256 ne sert que de repli
# pour d'anciens tokens symétriques. Optionnel mais recommandé de le renseigner.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
