# Reverse proxy WineMind — HTTPS automatique (Let's Encrypt via Caddy).
winemind.fr {
	encode gzip
	reverse_proxy api:8000
}

www.winemind.fr {
	redir https://winemind.fr{uri} permanent
}

# Reverse proxy Melo API — conteneurs déployés hors de ce compose
# (repo 8oDyy/melo-backend), joints via le réseau docker partagé "edge".
api.chickenbowl.fr {
	encode gzip
	reverse_proxy melo-api:8000
}

staging-api.chickenbowl.fr {
	encode gzip
	reverse_proxy melo-api-staging:8000
}

# Reverse proxy Contrôle RCM / TELT — déploiement DEV, conteneurs hors de ce
# compose (repo 8oDyy/lyon-turin-rcm), joints via le réseau docker partagé "edge".
rcm.212-227-3-85.sslip.io {
	encode gzip
	reverse_proxy rcm-app:8080
}

# Logs RCM (Dozzle) — auth gérée par Dozzle lui-même (/opt/rcm/dozzle/users.yml).
logs.rcm.212-227-3-85.sslip.io {
	encode gzip
	reverse_proxy rcm-dozzle:8080
}
